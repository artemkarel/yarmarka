# Токен бота от @BotFather
BOT_TOKEN=

# Публичный адрес мини-приложения (обязательно https)
BASE_URL=https://roznica.duckdns.org

# Telegram ID администраторов через запятую (узнать: команда /id у бота).
# Если пусто — первый зарегистрировавшийся пользователь станет админом.
ADMIN_IDS=

# Часовой пояс по умолчанию (если у пользователя не определился)
DEFAULT_TZ=Europe/Moscow

# Час напоминания об инкассации (по местному времени продавца)
REMIND_HOUR=20

# Режим разработки: разрешает вход без Telegram через заголовок X-Dev-User.
# На боевом сервере ДОЛЖНО быть 0.
DEV_MODE=0

HOST=127.0.0.1
PORT=8077
